# Copy to docker-compose.override.yml (gitignored) for host-specific config.
# Compose merges it over docker-compose.yml automatically.
services:
  flickr:
    # Behind a reverse proxy: drop the published port
    ports: !reset []
    labels:
      - traefik.enable=true
      - traefik.http.routers.flickr-http.rule=Host(`flickr.example.com`)
      - traefik.http.routers.flickr-http.entrypoints=web
      - traefik.http.routers.flickr-http.middlewares=flickr-https
      - traefik.http.middlewares.flickr-https.redirectscheme.scheme=https
      - traefik.http.routers.flickr.rule=Host(`flickr.example.com`)
      - traefik.http.routers.flickr.entrypoints=websecure
      - traefik.http.routers.flickr.tls=true
      - traefik.http.routers.flickr.tls.certresolver=letsencrypt
      - traefik.http.services.flickr.loadbalancer.server.port=8080
